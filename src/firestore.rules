rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      // Use get() instead of exists() for better performance and clarity.
      // Checks if the requesting user's UID has an entry in the admin roles collection.
      return get(/databases/$(database)/documents/roles_admin/$(request.auth.uid)).data.isAdmin == true;
    }

    // Rules for user profiles and roles
    // Only authenticated users can read the list of users for the login dropdown.
    match /app-users/{userId} {
      allow read: if request.auth != null;
      allow create: if isAdmin(); // Only admins can create new users.
      allow update: if isOwner(userId) || isAdmin(); // Users can update their own profile, admins can update any.
      allow delete: if isAdmin(); // Only admins can delete users.
    }
    
    match /roles_admin/{userId} {
      // Only admins can read or write role information.
      allow read, write: if isAdmin();
    }

    // Rules for shifts
    match /shifts/{shiftId} {
      // Any authenticated user can create a shift (start their clock).
      allow create: if request.auth != null;
      // Users can only read/update/delete their own shifts. Admins can manage any shift.
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
    }
    
    // Rules for leave requests
    match /leave-requests/{leaveRequestId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isOwner(resource.data.operatorId) || isAdmin();
    }
    
    // Rules for supply requests
    match /supply-requests/{supplyRequestId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isOwner(resource.data.operatorId) || isAdmin();
    }
    
    // Rules for extra shift requests
    match /extra-shift-requests/{requestId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
    }
    
    // Rules for communications
    match /communications/{commId} {
      allow create: if request.auth != null;
      allow read, update: if isOwner(resource.data.userId) || isAdmin();
    }
    
    // Rules for announcements
    match /announcements/{announcementId} {
      allow read: if request.auth != null; // All authenticated users can read announcements.
      allow write: if isAdmin(); // Only admins can create/update/delete announcements.
    }

    // Rules for warehouse items
    match /warehouse-items/{itemId} {
      allow read: if request.auth != null; // All authenticated users can see warehouse items.
      allow write: if isAdmin(); // Only admins can manage the warehouse.
    }
  }
}
