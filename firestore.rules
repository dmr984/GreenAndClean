rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // Regola Globale per Admin: Accesso completo a tutto il database.
    match /{path=**} {
      allow read, write: if isAdmin();
    }
    
    // Regole specifiche per gli operatori
    match /app-users/{userId} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId);
    }
    
    match /shifts/{shiftId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isOwner(resource.data.userId);
    }
    
    match /leave-requests/{leaveRequestId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isOwner(resource.data.operatorId);
    }
    
    match /supply-requests/{supplyRequestId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isOwner(resource.data.operatorId);
    }
    
    match /extra-shift-requests/{requestId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isOwner(resource.data.userId);
    }
    
    match /communications/{commId} {
      allow create: if request.auth != null;
      allow read: if isOwner(resource.data.userId);
    }
    
    // Tutti gli utenti autenticati possono leggere gli annunci, ma solo gli admin possono scrivere.
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
