
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // With a custom, non-Firebase Auth login system, we cannot reliably
    // use request.auth.uid for security rules. These rules are temporarily
    // opened up to allow development to proceed.
    // A more robust solution (e.g., custom tokens or a secure backend)
    // should be implemented before production.

    match /app-users/{userId} {
      // Allow anyone to read the user list for the login dropdown.
      allow list, get: if true; 
      
      // Allow anyone to update, create, or delete users for now.
      // This is insecure and for development purposes only.
      allow write: if true;
      
      match /timbrature/{timbraturaId} {
        // Allow anyone to read or write clocking events.
        allow read, write: if true;
      }
       match /straordinari/{straordinarioId} {
        allow read, write: if true;
      }

      match /requests/{requestId} {
        // Allow anyone to read or write requests.
        allow read, write: if true;
      }

      match /daily-notes/{noteId} {
        // Allow anyone to read or write daily notes.
        allow read, write: if true;
      }

      match /monthly-overrides/{monthId} {
        // Allow anyone to read or write monthly overrides.
        allow read, write: if true;
      }
    }
    
    // This rule is necessary for the admin notification bell to query
    // across all users' pending requests.
    match /{path=**}/requests/{requestId} {
      // Allow read access for collection group queries. This is insecure for
      // production but necessary for the current custom auth system.
      allow read: if true;
    }

    match /roles_admin/{adminId} {
        // Allow anyone to read or write admin roles.
        allow read, write: if true;
    }

    match /reports/{reportId} {
        // Allow anyone to read or write reports.
        allow read, write: if true;
    }
  }
}
