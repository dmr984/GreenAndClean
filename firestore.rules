
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      // Admins have a document in the /roles_admin collection with their UID.
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    function isUserAuthenticated() {
      return request.auth != null;
    }

    // Admins can be managed by other admins.
    match /admins/{adminId} {
      allow read, write: if isUserAuthenticated() && isAdmin();
    }
    
    // Role collection is readable by authenticated users to check for admin status.
    match /roles_admin/{adminId} {
      allow read: if isUserAuthenticated();
    }

    // All app users can be read by admins, but only owners or admins can write.
    match /app-users/{userId} {
      allow list: if isUserAuthenticated() && isAdmin();
      allow read: if isUserAuthenticated();
      allow write: if isUserAuthenticated() && (isOwner(userId) || isAdmin());
    }

    // Operator-specific data is owned by the operator, but readable by admins.
    match /operators/{operatorId} {
      allow read: if isUserAuthenticated() && (isOwner(operatorId) || isAdmin());
      allow write: if isUserAuthenticated() && isOwner(operatorId);
      
      // Subcollections are owned by the operator
      match /{subcollection}/{docId} {
        allow read, write: if isUserAuthenticated() && isOwner(operatorId);
      }
    }
    
    // Root level collections for admin queries
    match /shifts/{shiftId} {
      allow read, write: if isAdmin();
      allow create: if isUserAuthenticated();
      allow read, update: if isUserAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    match /leave-requests/{leaveRequestId} {
      allow read, write: if isAdmin();
      allow create: if isUserAuthenticated();
      allow read, update, delete: if isUserAuthenticated() && resource.data.operatorId == request.auth.uid;
    }
    
    match /supply-requests/{supplyRequestId} {
      allow read, write: if isAdmin();
      allow create: if isUserAuthenticated();
      allow read: if isUserAuthenticated() && resource.data.user == request.auth.token.name;
    }

    match /extra-shift-requests/{requestId} {
      allow read, write: if isUserAuthenticated();
    }

    // Announcements can be read by anyone, but only written by admins.
    match /announcements/{announcementId} {
      allow read: if isUserAuthenticated();
      allow write: if isUserAuthenticated() && isAdmin();
    }
    
    // This collection is not defined in backend.json, but provide rules for it
    match /communications/{commId} {
      allow read, write: if isUserAuthenticated();
    }
    
    // Warehouse items can only be managed by admins.
     match /warehouse-items/{itemId} {
      allow read, list, write: if isUserAuthenticated() && isAdmin();
    }
  }
}
