rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return get(/databases/$(database)/documents/app-users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isUserUnauthenticated() {
        return request.auth == null;
    }
    
    match /app-users/{userId} {
      allow read, write: if isAdmin() || isOwner(userId);
      allow delete: if isAdmin();
    }
     match /roles_admin/{userId} {
      allow read, write: if isAdmin();
    }
     match /shifts/{shiftId} {
      allow read, write: if isOwner(request.resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
