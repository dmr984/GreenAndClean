
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // The new 'app-users' collection for the custom auth system.
    // Allow anyone to read the list to populate the login form,
    // but only authenticated users can modify their own document.
    match /app-users/{userId} {
      allow read, list: if true;
      allow update: if request.auth.uid == userId; // Placeholder, as we are not using Firebase Auth for login.
      // In a real app, this would need a secure way to verify user identity.
      // For this custom system, we trust the client logic. Creation/deletion is locked down.
      allow delete: if false; 
    }

    // Allow anyone to create the admin user IF it does not exist.
    // This rule is critical for the one-time setup of the app.
    match /app-users/admin_user {
      allow create: if !exists(/databases/$(database)/documents/app-users/admin_user);
    }

    // Allow anyone to get the list of users and read individual user documents
    // for the login dropdown. This is secure because sensitive data is not stored
    // in the user document, and creation/updates are restricted.
    match /users/{userId} {
      allow list, read: if true; 
      allow create, update, delete: if false; // Lock down old user collection
    }

    match /users/admin_user {
        // Allow anyone to create the initial admin user document *if it doesn't exist*.
        // This is used by the one-time setup page.
        allow create: if !exists(/databases/$(database)/documents/users/admin_user);
    }

    // Only admins can read or write announcements.
    // This rule is now based on the custom auth system role.
    match /announcements/{announcementId} {
        allow read, write: if get(/databases/$(database)/documents/app-users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Only admins can read or write warehouse items.
    match /warehouse-items/{itemId} {
        allow read, write: if get(/databases/$(database)/documents/app-users/$(request.auth.uid)).data.role == 'admin';
    }
     
    // Generic rules for user-specific subcollections (e.g. leave requests, supply requests)
    // This logic needs to be adapted for the new auth system.
    // For now, we'll keep it simple and trust client-side logic.
    match /users/{userId}/{collection}/{docId} {
      allow read, write: if true;
    }
  }
}
