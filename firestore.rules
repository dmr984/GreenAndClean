rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) || request.auth.uid == "admin_user";
    }

    // Regola Globale per Admin: Accesso completo a tutto il database.
    // Questa regola è la più permissiva possibile e previene errori di permessi per gli admin.
    match /{path=**} {
      allow read, write: if isAdmin();
    }
    
    // Regole per Utenti non-Admin
    
    // La collezione 'app-users' può essere letta da qualsiasi utente autenticato (per il login),
    // ma ogni utente può scrivere solo nel proprio documento.
    match /app-users/{userId} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId);
    }
    
    // Gli operatori possono creare turni, ma possono leggere, aggiornare o eliminare solo i propri.
    match /shifts/{shiftId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isOwner(resource.data.userId);
    }
    
    // Gli operatori possono creare richieste di ferie, ma possono leggere, aggiornare o eliminare solo le proprie.
    match /leave-requests/{leaveRequestId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isOwner(resource.data.operatorId);
    }
    
    // Gli operatori possono creare richieste di forniture, ma possono leggere, aggiornare o eliminare solo le proprie.
    match /supply-requests/{supplyRequestId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isOwner(resource.data.operatorId);
    }
    
    match /extra-shift-requests/{requestId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isOwner(resource.data.userId);
    }
    
    // Gli operatori possono creare comunicazioni e leggere solo le proprie.
    match /communications/{commId} {
      allow create: if request.auth != null;
      allow read: if isOwner(resource.data.userId);
    }
    
    // Tutti gli utenti autenticati possono leggere gli annunci.
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
    }
  }
}
