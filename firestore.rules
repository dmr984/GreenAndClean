rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      // Use exists() for a more secure and efficient check.
      // This checks if a document for the user's UID exists in the roles_admin collection.
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    match /app-users/{userId} {
      // Allow unauthenticated users to LIST users for login dropdown.
      allow list: if request.auth == null;
      // Allow an admin or the document owner to read.
      allow read: if isAdmin() || isOwner(userId);
      // Allow write operations (create, update) only for initial setup from an unauthenticated client.
      // This is necessary for the initial user batch write.
      // For authenticated users, specific update rules apply.
      allow write: if request.auth == null;
      // Allow authenticated admins or the owner to update their own document.
      allow update: if isAdmin() || isOwner(userId);
      // Only admins can delete users.
      allow delete: if isAdmin();
    }

     match /roles_admin/{userId} {
      // Admins can read or write roles.
      allow read, write: if isAdmin();
      // Allow creation only for initial setup from an unauthenticated client.
      allow create: if request.auth == null;
    }
  }
}
