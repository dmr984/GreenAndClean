rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      // Use exists() for a more secure and efficient check.
      // This checks if a document for the user's UID exists in the roles_admin collection.
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    match /app-users/{userId} {
      // Allow an unauthenticated user to GET a single document for login verification.
      // Allow an admin or the owner to GET their document.
      allow get: if request.auth == null || isAdmin() || isOwner(userId);
      // Allow any user (authenticated or not) to list users for the login dropdown.
      // The query in the app (`where("visibleInLogin", "==", true)`) ensures only intended users are shown.
      allow list: if true;
      // Allow write operations only for initial setup from an unauthenticated client or by an admin
      allow create: if request.auth == null || isAdmin();
      // Allow authenticated admins or the owner to update their own document.
      allow update: if isAdmin() || isOwner(userId);
      // Only admins can delete users.
      allow delete: if isAdmin();

      // Rules for the 'timbrature' subcollection
      match /timbrature/{timbraturaId} {
        // An operator can create their own clocking events.
        allow create: if isOwner(userId);
        // An operator can read their own clocking events. Admins can read anyone's.
        allow read: if isOwner(userId) || isAdmin();
        // Admins can update the status of a clocking event (e.g., to approve it).
        allow update: if isAdmin();
        // No one should be able to delete clocking events through the app.
        allow delete: if false;
      }
    }

     match /roles_admin/{userId} {
      // Admins can read or write roles.
      allow read, write: if isAdmin();
      // Allow creation only for initial setup from an unauthenticated client.
      allow create: if request.auth == null;
    }
  }
}
