
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /operators/{operatorId} {
      allow read, write: if request.auth != null && request.auth.uid == operatorId;
    }

    match /admins/{adminId} {
      allow read, write: if request.auth != null && request.auth.uid == adminId;
    }

    match /operators/{operatorId}/shifts/{shiftId} {
      allow read, write: if request.auth != null && request.auth.uid == operatorId;
    }

    match /operators/{operatorId}/leaveRequests/{leaveRequestId} {
      allow create: if request.auth != null && request.resource.data.operatorId == request.auth.uid;
      allow read, update, delete: if request.auth != null && request.auth.uid == operatorId;
    }

    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /operators/{operatorId}/supplyRequests/{supplyRequestId} {
      allow read, write: if request.auth != null && request.auth.uid == operatorId;
    }

    match /roles_admin/{adminId} {
      allow read: if request.auth != null;
    }

    // Admin access rules
    match /shifts/{shiftId} {
      allow read, write: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Corrected rule for leave-requests collection
    match /leave-requests/{leaveRequestId} {
       // Allow users to create their own requests
       allow create: if request.auth != null;
       
       // Allow users to read THEIR OWN requests (list and get)
       allow read: if request.auth != null && (
         (request.path[2] == 'leave-requests' && request.query.where.user == get(/databases/$(database)/documents/app-users/$(request.auth.uid)).data.username) ||
         (resource.data.user == get(/databases/$(database)/documents/app-users/$(request.auth.uid)).data.username)
       );
       
       // Allow users to update/delete THEIR OWN requests (if pending)
       allow update, delete: if request.auth != null && get(/databases/$(database)/documents/leave-requests/$(leaveRequestId)).data.user == get(/databases/$(database)/documents/app-users/$(request.auth.uid)).data.username;

       // Allow admins to do anything
       allow read, write, update, delete: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
     match /supply-requests/{supplyRequestId} {
      allow read, update: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
     match /extra-shift-requests/{requestId} {
      allow read, write: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
     match /app-users/{userId} {
      allow read, write: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
     match /communications/{commId} {
      allow read, write: if request.auth != null;
    }
     match /warehouse-items/{itemId} {
      allow read, write: if request.auth != null;
    }

  }
}
