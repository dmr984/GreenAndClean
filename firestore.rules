/**
 * @fileoverview Firestore Security Rules for WorkForce Hub application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for operators and admins,
 * combined with role-based access for administrative functions. All data is
 * nested under /operators/{operatorId} or /admins/{adminId}, ensuring that
 * users can only access their own data, unless they have admin privileges.
 * Admin privileges are granted by the existence of a document in the
 * `/roles_admin/{adminId}` collection.
 *
 * Data Structure:
 * - /operators/{operatorId}: Stores operator profiles.
 * - /admins/{adminId}: Stores admin profiles.
 * - /operators/{operatorId}/shifts/{shiftId}: Stores shift data for operators.
 * - /operators/{operatorId}/leaveRequests/{leaveRequestId}: Stores leave requests.
 * - /operators/{operatorId}/supplyRequests/{supplyRequestId}: Stores supply requests.
 * - /announcements/{announcementId}: Stores announcements created by admins.
 * - /roles_admin/{adminId}: Stores admin role assignments.
 *
 * Key Security Decisions:
 * - User data is strictly segregated and accessible only to the user and admins.
 * - Admin privileges are role-based and determined by document existence in `/roles_admin/{adminId}`.
 * - List operations are secured to prevent unauthorized data access.
 * - Data validation is minimized to focus on authorization and relational integrity,
 *   allowing for flexible data shapes during prototyping.
 *
 * Denormalization for Authorization:
 * - Admin privileges are determined by the existence of a document in the
 *   `/roles_admin/{adminId}` collection, avoiding complex queries.
 *
 * Structural Segregation:
 * - Operator and admin data are stored in separate top-level collections to
 *   maintain clear access boundaries.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants access to operator profile data.
     * @path /operators/{operatorId}
     * @allow (create) Operator with matching id can create their profile.
     * @allow (get, update, delete) Operator with matching id can access their profile. Admins can access any operator profile.
     * @deny (create, update, delete) Operators cannot access other operator profiles.
     * @principle Enforces document ownership and admin override.
     */
    match /operators/{operatorId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }
      allow get: if isSignedIn() && (isOwner(operatorId) || isAdmin());
      allow list: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() && isOwner(operatorId) && request.resource.data.id == request.auth.uid;
      allow update: if isSignedIn() && (isOwner(operatorId) || isAdmin()) && resource != null && request.resource.data.id == resource.data.id;
      allow delete: if isSignedIn() && (isOwner(operatorId) || isAdmin()) && resource != null;
    }

    /**
     * @description Grants access to admin profile data.
     * @path /admins/{adminId}
     * @allow (create) Admin with matching id can create their profile.
     * @allow (get, update, delete) Admin with matching id can access their profile.
     * @deny (create, update, delete) Admins cannot access other admin profiles.
     * @principle Enforces document ownership.
     */
    match /admins/{adminId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get: if isSignedIn() && isOwner(adminId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(adminId) && request.resource.data.id == request.auth.uid;
      allow update: if isSignedIn() && isOwner(adminId) && resource != null && request.resource.data.id == resource.data.id;
      allow delete: if isSignedIn() && isOwner(adminId) && resource != null;
    }

    /**
     * @description Grants access to shift data for operators.
     * @path /operators/{operatorId}/shifts/{shiftId}
     * @allow (create, get, list, update, delete) Operator with matching id can access their own shifts. Admins can access any operator's shifts.
     * @deny (create, get, list, update, delete) Operators cannot access other operator's shifts.
     * @principle Enforces document ownership and admin override.
     */
    match /operators/{operatorId}/shifts/{shiftId} {
      function isOwner(operatorId) {
        return request.auth.uid == operatorId;
      }
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }
      allow get: if isSignedIn() && (isOwner(operatorId) || isAdmin());
      allow list: if isSignedIn() && (isOwner(operatorId) || isAdmin());
      allow create: if isSignedIn() && (isOwner(operatorId) || isAdmin()) && request.resource.data.operatorId == operatorId;
      allow update: if isSignedIn() && (isOwner(operatorId) || isAdmin()) && resource != null && resource.data.operatorId == operatorId;
      allow delete: if isSignedIn() && (isOwner(operatorId) || isAdmin()) && resource != null;
    }

    /**
     * @description Grants access to leave requests submitted by operators.
     * @path /operators/{operatorId}/leaveRequests/{leaveRequestId}
     * @allow (create, get, list, update, delete) Operator with matching id can access their own leave requests. Admins can access any operator's leave requests.
     * @deny (create, get, list, update, delete) Operators cannot access other operator's leave requests.
     * @principle Enforces document ownership and admin override.
     */
    match /operators/{operatorId}/leaveRequests/{leaveRequestId} {
      function isOwner(operatorId) {
        return request.auth.uid == operatorId;
      }
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }
      allow get: if isSignedIn() && (isOwner(operatorId) || isAdmin());
      allow list: if isSignedIn() && (isOwner(operatorId) || isAdmin());
      allow create: if isSignedIn() && (isOwner(operatorId) || isAdmin()) && request.resource.data.operatorId == operatorId;
      allow update: if isSignedIn() && (isOwner(operatorId) || isAdmin()) && resource != null && resource.data.operatorId == operatorId;
      allow delete: if isSignedIn() && (isOwner(operatorId) || isAdmin()) && resource != null;
    }

    /**
     * @description Grants access to announcements created by administrators.
     * @path /announcements/{announcementId}
     * @allow (get, list) All signed-in users can view announcements.
     * @allow (create, update, delete) Only admins can create, update, or delete announcements.
     * @deny (create, update, delete) Non-admins cannot create, update, or delete announcements.
     * @principle Enforces role-based access for announcements.
     */
    match /announcements/{announcementId} {
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin() && resource != null;
      allow delete: if isSignedIn() && isAdmin() && resource != null;
    }

    /**
     * @description Grants access to supply requests submitted by operators.
     * @path /operators/{operatorId}/supplyRequests/{supplyRequestId}
     * @allow (create, get, list, update, delete) Operator with matching id can access their own supply requests. Admins can access any operator's supply requests.
     * @deny (create, get, list, update, delete) Operators cannot access other operator's supply requests.
     * @principle Enforces document ownership and admin override.
     */
    match /operators/{operatorId}/supplyRequests/{supplyRequestId} {
      function isOwner(operatorId) {
        return request.auth.uid == operatorId;
      }
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }
      allow get: if isSignedIn() && (isOwner(operatorId) || isAdmin());
      allow list: if isSignedIn() && (isOwner(operatorId) || isAdmin());
      allow create: if isSignedIn() && (isOwner(operatorId) || isAdmin()) && request.resource.data.operatorId == operatorId;
      allow update: if isSignedIn() && (isOwner(operatorId) || isAdmin()) && resource != null && resource.data.operatorId == operatorId;
      allow delete: if isSignedIn() && (isOwner(operatorId) || isAdmin()) && resource != null;
    }

    /**
     * @description Grants admin privileges based on document existence in this collection.
     * @path /roles_admin/{adminId}
     * @allow (get) Any signed-in user can check if they are an admin.
     * @allow (create) Only the user with matching id can create their admin role.
     * @deny (create, update, delete) Admins cannot access other admin roles.
     * @principle Enforces role-based access for administrators.
     */
    match /roles_admin/{adminId} {
      function isOwner(adminId) {
        return request.auth.uid == adminId;
      }
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && isOwner(adminId);
      allow update: if false;
      allow delete: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
  }
}