rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return get(/databases/$(database)/documents/roles_admin/$(request.auth.uid)).data.isAdmin == true;
    }
    
    match /app-users/{userId} {
      allow list: if request.auth == null; // Allow unauthenticated users to list users for login dropdown
      allow read, write: if isAdmin() || isOwner(userId);
      allow create: if isAdmin(); // Only admins can create new users
      allow delete: if isAdmin();
    }

     match /roles_admin/{userId} {
      allow read, write: if isAdmin();
      allow create: if isAdmin(); // Only admins can create new admin roles
    }
  }
}
