rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return get(/databases/$(database)/documents/app-users/$(request.auth.uid)).data.role == 'admin';
    }
    
    match /app-users/{userId} {
      allow read, write: if isAdmin() || isOwner(userId);
      allow create: if request.resource.data.role == 'admin'; // Allow initial admin creation
      allow delete: if isAdmin();
    }

     match /roles_admin/{userId} {
      allow read, write: if isAdmin();
      allow create: if request.auth.uid == userId; // Allow user to create their own admin role during setup
    }
  }
}
