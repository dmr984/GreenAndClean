rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return get(/databases/$(database)/documents/roles_admin/$(request.auth.uid)).data.isAdmin == true;
    }
    
    match /app-users/{userId} {
      allow list: if request.auth == null; // Allow unauthenticated users to list users for login dropdown
      allow read, write: if isAdmin() || isOwner(userId);
      allow create: if request.auth == null; // Allow initial user creation
      allow delete: if isAdmin();
    }

     match /roles_admin/{userId} {
      allow read, write: if isAdmin();
      // Allow role creation if the corresponding user in 'app-users' is an admin.
      // This is necessary for the initial admin setup.
      allow create: if request.auth == null && getAfter(/databases/$(database)/documents/app-users/$(userId)).data.role == 'admin';
    }
  }
}
