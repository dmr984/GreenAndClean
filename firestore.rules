rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      // Check for admin role in 'roles_admin' collection.
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // Global Admin Rule: Admins can read and write everything.
    // This is the most permissive rule to prevent any permission-denied errors for admins.
    match /{path=**} {
      allow read, write: if isAdmin();
    }
    
    match /app-users/{userId} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId);
    }
    
    match /shifts/{shiftId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isOwner(resource.data.userId);
    }
    
    match /leave-requests/{leaveRequestId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isOwner(resource.data.operatorId);
    }
    
    match /supply-requests/{supplyRequestId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isOwner(resource.data.operatorId);
    }
    
    match /extra-shift-requests/{requestId} {
      allow create: if request.auth != null;
      allow read: if isOwner(resource.data.userId);
    }
    
    match /communications/{commId} {
        allow create: if request.auth != null;
        allow read: if isOwner(resource.data.userId);
    }
    
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
    }
  }
}
