rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin(userId) {
      // Checks if a document for the user's ID exists in the roles_admin collection.
      // This is insecure without a real auth system.
      return exists(/databases/$(database)/documents/roles_admin/$(userId));
    }
    
    // Allow anyone to read the user list for the login dropdown.
    match /app-users/{userId} {
      allow list: if true;
      allow get: if true; // Allow getting a single user doc for login check.
      
      // Allow an admin to update/create/delete any user.
      // A user can update their own document if they provide the correct password.
      // This is NOT secure, as the password is sent over the wire.
      // This is a temporary measure based on user request for simplicity.
      allow write: if isAdmin(userId) || request.resource.data.password == resource.data.password;
      allow delete: if isAdmin(userId);
      
      // Rules for the 'timbrature' subcollection
      match /timbrature/{timbraturaId} {
        // Allow creating if the userId in the path matches the userId in the request data.
        allow create: if request.resource.data.userId == userId;
        // Allow anyone to read the clocking events. This is insecure but necessary
        // for the custom auth system to work.
        allow read: if true;
        // Admins can update the status of a clocking event (e.g., to approve it).
        allow update: if isAdmin(userId);
        // No one should be able to delete clocking events through the app.
        allow delete: if false;
      }
    }

     match /roles_admin/{userId} {
      // Only an authenticated admin can read or write roles.
      // This is insecure without a proper auth system.
      allow read, write: if isAdmin(userId);
    }
  }
}
