
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Funzione per verificare se l'utente è il proprietario del documento
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Funzione per verificare se l'utente è un amministratore
    function isAdmin() {
      // Gli amministratori hanno un documento nella collezione /roles_admin con il loro UID.
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // Regola generale: gli amministratori hanno accesso completo a tutto.
    // Questa regola risolve i problemi di permessi per le query di list.
    match /{path=**} {
      allow read, write: if isAdmin();
    }

    // Regole specifiche per gli operatori (si applicano quando isAdmin() è falso)

    // La collezione roles_admin è leggibile da tutti gli utenti autenticati per permettere
    // al client di verificare lo stato di amministratore se necessario.
    match /roles_admin/{adminId} {
      allow get: if request.auth != null;
    }

    // La collezione app-users è leggibile da tutti, ma scrivibile solo dal proprietario
    match /app-users/{userId} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId);
    }
    
    // Gli operatori possono creare, leggere e aggiornare solo i propri turni
    match /shifts/{shiftId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Gli operatori possono creare e gestire solo le proprie richieste di ferie
    match /leave-requests/{leaveRequestId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && resource.data.operatorId == request.auth.uid;
    }

    // Gli operatori possono creare e leggere solo le proprie richieste di forniture
    match /supply-requests/{supplyRequestId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && resource.data.user == request.auth.token.name;
    }
    
    // Gli operatori possono creare e leggere solo le proprie richieste di timbratura extra
    match /extra-shift-requests/{requestId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Le comunicazioni possono essere create e lette solo dal proprietario
    match /communications/{commId} {
        allow create: if request.auth != null;
        allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Gli annunci sono leggibili da tutti gli utenti autenticati
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
    }
  }
}
