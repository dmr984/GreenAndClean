
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // Global Admin Rule: Admins can read and write everything.
    // This is the most permissive rule to prevent any permission-denied errors for admins.
    match /{path=**} {
      allow read, write: if isAdmin();
    }

    // Specific rules for non-admin users (operators)

    // The roles_admin collection is get-able by any authenticated user if needed
    // for client-side role checks.
    match /roles_admin/{adminId} {
      allow get: if request.auth != null;
    }

    // app-users collection: Read-all, but only owners can write to their own document.
    match /app-users/{userId} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId);
    }
    
    // Operators can only create, read, update, and delete their own shifts.
    match /shifts/{shiftId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isOwner(resource.data.userId);
    }

    // Operators can only create and manage their own leave requests.
    match /leave-requests/{leaveRequestId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isOwner(resource.data.operatorId);
    }

    // Operators can only create and read their own supply requests.
    match /supply-requests/{supplyRequestId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && resource.data.user == request.auth.token.name;
    }
    
    // Operators can only create and read their own extra shift requests.
    match /extra-shift-requests/{requestId} {
      allow create: if request.auth != null;
      allow read: if isOwner(resource.data.userId);
    }
    
    // Communications can only be created and read by their owner.
    match /communications/{commId} {
        allow create: if request.auth != null;
        allow read: if isOwner(resource.data.userId);
    }

    // Announcements are readable by all authenticated users.
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
    }

    // Warehouse items can only be managed by admins (covered by global rule).
    match /warehouse-items/{itemId} {
      // No explicit operator rules needed here.
    }
  }
}
