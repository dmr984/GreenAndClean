rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      // Check if a document for the user exists in the roles_admin collection
      // This rule is problematic for client-side checks because it requires a read.
      // We will rely on server-side validation or client-side role checking after auth.
      // For now, this is a placeholder. A robust solution uses custom claims.
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    // Allow unauthenticated user creation and role setup for the very first time
    match /app-users/{userId} {
      allow read, write: if request.auth == null;
      allow read, write: if request.auth.uid == userId;
      allow read, write: if isAdmin();
    }
     match /roles_admin/{userId} {
      allow write: if request.auth == null;
      allow read, write: if isAdmin();
    }

    // Authenticated users can read their own profile
    match /app-users/{userId} {
      allow read: if request.auth != null;
      allow update: if request.auth.uid == userId;
    }

    // Rules for top-level shifts collection
    match /shifts/{shiftId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth.uid == resource.data.userId || isAdmin();
    }
    
    // Rules for top-level leave-requests collection
    match /leave-requests/{leaveRequestId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth.uid == resource.data.operatorId || isAdmin();
    }
    
    // Rules for top-level supply-requests collection
    match /supply-requests/{supplyRequestId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth.uid == resource.data.operatorId || isAdmin();
    }
    
    // Rules for top-level extra-shift-requests collection
    match /extra-shift-requests/{requestId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth.uid == resource.data.userId || isAdmin();
    }
    
    // Rules for top-level warehouse-items collection
    match /warehouse-items/{itemId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Global admin read/write access
     match /{path=**} {
      allow read, write: if isAdmin();
    }
  }
}
